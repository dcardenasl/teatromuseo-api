#--------------------------------------------------------------------
# Example Environment Configuration File
#
# Copy this file to .env and customize the values for your environment.
# NEVER commit .env to git - it contains sensitive credentials!
#
# Command: cp .env.example .env
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP — REQUIRED
#--------------------------------------------------------------------
# Base URL of this API. This is used as the JWT token issuer claim.
# Domain apps validate tokens by checking this issuer against the hub's URL.
#
# REQUIRED: Set this to your API server URL
app.baseURL = 'http://localhost:8080'

# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

# Public web app URL used for email links (verify/reset/invitation)
WEBAPP_BASE_URL = 'http://localhost:8081'

# Optional allowlist for client-provided base URLs (comma-separated)
# If empty, only WEBAPP_BASE_URL is allowed.
WEBAPP_ALLOWED_BASE_URLS = 'http://localhost:8081'

#--------------------------------------------------------------------
# DATABASE - Local Development
#--------------------------------------------------------------------

database.default.hostname = 127.0.0.1
database.default.database = ci4_website_builder_api
database.default.username = root
database.default.password = YOUR_DATABASE_PASSWORD_HERE
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

# Test database configuration
database.tests.hostname = 127.0.0.1
database.tests.database = ci4_website_builder_api_test
database.tests.username = root
database.tests.password = YOUR_DATABASE_PASSWORD_HERE
database.tests.DBDriver = MySQLi
database.tests.DBPrefix = ""
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_general_ci
database.tests.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# CRITICAL: Generate a secure key for production!
# Run: php spark key:generate
encryption.key = ""

#--------------------------------------------------------------------
# JWT AUTHENTICATION
#--------------------------------------------------------------------

# CRITICAL: Change this to a strong random value in production!
# Generate with: openssl rand -base64 64
JWT_SECRET_KEY = ""

# JWT token expiration (in seconds)
JWT_ACCESS_TOKEN_TTL = 3600

# Refresh token expiration (in seconds, 7 days default)
JWT_REFRESH_TOKEN_TTL = 604800

# Enable token revocation checking (checks token blacklist before allowing request)
JWT_REVOCATION_CHECK = true

# Token revocation cache TTL in seconds (reduces DB lookups, must be less than token TTL)
JWT_REVOCATION_CACHE_TTL = 60

# Service token (machine-to-machine) expiration in seconds — issued by POST /auth/service-token
JWT_SERVICE_TOKEN_TTL = 900

# Require email verification before allowing login/refresh/protected routes
AUTH_REQUIRE_EMAIL_VERIFICATION = true

# Google OAuth client ID used to validate Google ID tokens
GOOGLE_CLIENT_ID =

#--------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
#--------------------------------------------------------------------

# Comma-separated list of allowed origins
# Examples:
#   Development: http://localhost:3000,http://localhost:5173
#   Production: https://app.example.com,https://admin.example.com
#   Wildcard subdomain: https://*.example.com
#   Allow all (NOT RECOMMENDED in production): *
CORS_ALLOWED_ORIGINS = 'http://localhost:3000,http://localhost:8080,http://localhost:5173'

# Enable Access-Control-Allow-Credentials header (sends CORS credentials with cross-origin requests)
CORS_SUPPORTS_CREDENTIALS = false

# Override CORS defaults only if needed (leave commented to use smart defaults)
# CORS_ALLOWED_METHODS = default: GET,POST,PUT,PATCH,DELETE,OPTIONS
# CORS_ALLOWED_HEADERS = default: Content-Type,Authorization,X-App-Key,X-Requested-With,X-Request-Id,Accept,Origin
# CORS_EXPOSED_HEADERS = expose these headers to JavaScript in browser (e.g., X-RateLimit-*)
# CORS_MAX_AGE = 86400 (preflight cache time in seconds, 24 hours default)

#--------------------------------------------------------------------
# Trusted reverse-proxy IPs
#--------------------------------------------------------------------
# When the app runs behind a load balancer / reverse proxy (ALB, nginx,
# Cloudflare, etc.), set this so CodeIgniter trusts the X-Forwarded-For
# (or equivalent) header. Without it, ThrottleFilter rate-limits everyone
# under the proxy's single IP and audit logs lose the real client IP.
#
# Format: comma-separated `cidr=header` pairs.
# Examples:
#   app.proxyIPs = '10.0.0.0/8=X-Forwarded-For'
#   app.proxyIPs = '10.0.1.200=X-Forwarded-For,192.168.5.0/24=X-Real-IP'
# Leave empty when no proxy is in front of the app.
# app.proxyIPs = ''

#--------------------------------------------------------------------
# RATE LIMITING
#--------------------------------------------------------------------

# Maximum requests per window (per IP or token)
RATE_LIMIT_REQUESTS = 60

# Time window in seconds (applies to RATE_LIMIT_REQUESTS above)
RATE_LIMIT_WINDOW = 60

# Requests per window for authenticated users (higher than global limit)
RATE_LIMIT_USER_REQUESTS = 100

# Authentication-specific rate limiting (stricter for login/register/password-reset)
# Maximum authentication attempts per window (per IP).
# Development baseline. Production must set stricter values in its deployment environment.
AUTH_RATE_LIMIT_REQUESTS = 20

# Authentication rate limit window in seconds (5 minutes in development)
AUTH_RATE_LIMIT_WINDOW = 300

#--------------------------------------------------------------------
# API KEY RATE LIMITING
#--------------------------------------------------------------------

# Maximum requests per window for API key clients (global key budget)
API_KEY_RATE_LIMIT_DEFAULT = 600

# Per-user request budget when an authenticated user sends requests with an API key
API_KEY_USER_RATE_LIMIT_DEFAULT = 60

# Per-IP defensive limit when an unauthenticated client uses an API key
API_KEY_IP_RATE_LIMIT_DEFAULT = 200

# Rate limit window in seconds for API key clients
API_KEY_WINDOW_DEFAULT = 60

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# logger.threshold = 4

#--------------------------------------------------------------------
# EMAIL CONFIGURATION
#--------------------------------------------------------------------

# Email service settings
EMAIL_FROM_ADDRESS = noreply@example.com
EMAIL_FROM_NAME = "API Application"

# Email provider: smtp, sendmail, mail
EMAIL_PROVIDER = smtp

# SMTP Configuration
# For development, use Mailtrap.io or similar service
EMAIL_SMTP_HOST = smtp.mailtrap.io
EMAIL_SMTP_PORT = 2525
EMAIL_SMTP_USER =
EMAIL_SMTP_PASS =
EMAIL_SMTP_CRYPTO = tls

# Alternative SMTP examples:
# Gmail: smtp.gmail.com:587 (requires app password)
# SendGrid: smtp.sendgrid.net:587
# Amazon SES: email-smtp.us-east-1.amazonaws.com:587

#--------------------------------------------------------------------
# QUEUE CONFIGURATION
#--------------------------------------------------------------------

# Queue driver: database, redis, sync
# database = Store jobs in database (default)
# redis = Store jobs in Redis (faster, requires Redis)
# sync = Execute immediately (no queue, for testing)
QUEUE_DRIVER = database

# Redis configuration (if using redis driver)
QUEUE_REDIS_HOST = 127.0.0.1
QUEUE_REDIS_PORT = 6379
QUEUE_REDIS_PASSWORD =
QUEUE_REDIS_DATABASE = 0

# Database connection for queue storage (when QUEUE_DRIVER = database)
# Defaults to 'tests' in testing environment, 'default' otherwise
# QUEUE_DATABASE_CONNECTION = default

# Queue retry settings
QUEUE_MAX_ATTEMPTS = 3
QUEUE_RETRY_AFTER = 90

#--------------------------------------------------------------------
# AUDIT LOGGING
#--------------------------------------------------------------------

# Enable asynchronous audit logging (queued for later processing, faster responses)
# false in testing environment, true in others
AUDIT_ASYNC_ENABLED = true

# Queue name for audit log jobs (when AUDIT_ASYNC_ENABLED = true)
# AUDIT_QUEUE_NAME = audit

# Maximum audit log payload size in bytes (prevents oversized queue entries)
# AUDIT_MAX_PAYLOAD_BYTES = 60000

# Retention period for audit logs in days (older logs deleted by audit:clean command)
# AUDIT_RETENTION_DAYS = 90

#--------------------------------------------------------------------
# LOGGING CONFIGURATION
#--------------------------------------------------------------------

# Log level: debug, info, notice, warning, error, critical, alert, emergency
LOG_LEVEL = debug

# Log format: json, text
LOG_FORMAT = json

# Include database queries in logs (development only)
LOG_INCLUDE_QUERIES = true

#--------------------------------------------------------------------
# SENTRY ERROR TRACKING
#--------------------------------------------------------------------

# Sentry DSN (leave empty to disable)
SENTRY_DSN =

# Environment name for Sentry
SENTRY_ENVIRONMENT = development

# Sample rate for performance monitoring (0.0 to 1.0)
SENTRY_TRACES_SAMPLE_RATE = 0.2

#--------------------------------------------------------------------
# MONITORING & METRICS
#--------------------------------------------------------------------

# Enable monitoring features
MONITORING_ENABLED = true

# Slow query threshold in milliseconds
SLOW_QUERY_THRESHOLD = 1000

# Enable metrics collection
METRICS_ENABLED = true

# Enable request/response logging
REQUEST_LOGGING_ENABLED = true

# SLO target for API request latency (p95, in milliseconds)
SLO_API_P95_TARGET_MS = 500

#--------------------------------------------------------------------
# PAGINATION & SEARCH
#--------------------------------------------------------------------

# Default number of items per page
PAGINATION_DEFAULT_LIMIT = 20

# Maximum number of items per page
PAGINATION_MAX_LIMIT = 100

# Minimum search query length (prevents noise from too-short queries)
SEARCH_MIN_LENGTH = 3

# Enable full-text search functionality across all searchable endpoints
SEARCH_ENABLED = true

# Use database FULLTEXT search (vs simple LIKE). Requires FULLTEXT index on searchable columns
SEARCH_USE_FULLTEXT = true

#--------------------------------------------------------------------
# FILE STORAGE
#--------------------------------------------------------------------

# Storage driver: local, s3
FILE_STORAGE_DRIVER = local

# Maximum file size in bytes (10MB default)
FILE_MAX_SIZE = 10485760

# Allowed file types (comma-separated)
FILE_ALLOWED_TYPES = jpg,jpeg,png,gif,pdf,doc,docx,txt,zip

# Local storage path (relative to FCPATH)
FILE_UPLOAD_PATH = writable/uploads/

# File policy defaults
FILE_DEFAULT_VISIBILITY = private
FILE_ALLOWED_VISIBILITY = private,public
FILE_USER_SCOPED_FILES = false
FILE_ALLOW_PRIVILEGED_READ_BYPASS = true
FILE_ALLOW_PUBLIC_VISIBILITY = true

# Enable ClamAV scanning for uploaded files
FILES_VIRUS_SCAN_ENABLED = false

# ClamAV daemon socket/address
FILES_CLAMAV_ADDRESS = tcp://127.0.0.1:3310

# Control whether file access is scoped per authenticated user.
# true (default): each user can only list/download their own files.
# false: any authenticated user can list and download all files.
# Upload and delete ownership rules are NOT affected by this setting.
FILES_USER_SCOPED = true

#--------------------------------------------------------------------
# AWS S3 CONFIGURATION (when FILE_STORAGE_DRIVER = s3)
#--------------------------------------------------------------------

# AWS IAM Access Key ID
# Create dedicated IAM user with permissions: s3:PutObject, s3:GetObject, s3:DeleteObject, s3:ListBucket
# NEVER use root credentials
AWS_ACCESS_KEY_ID =

# AWS IAM Secret Access Key
AWS_SECRET_ACCESS_KEY =

# AWS Region where S3 bucket is located
# Common regions: us-east-1 (N.Virginia), us-west-2 (Oregon), eu-west-1 (Ireland)
AWS_DEFAULT_REGION = us-east-1

# S3 Bucket Name (must be globally unique)
# Example: myapp-uploads-production
# Recommended settings:
#   - Versioning: Enabled
#   - Block public access: Enabled
#   - Encryption: AES-256 or KMS
AWS_BUCKET =

# Custom Base URL for file access (OPTIONAL)
# Use for CloudFront CDN or custom domain
# If empty, uses default: https://{bucket}.s3.{region}.amazonaws.com/{path}
# Example: https://d1234567890.cloudfront.net
AWS_URL =
